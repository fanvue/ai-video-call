# Get these from the Fanvue Developer Area when you create an app https://fanvue.com/developers
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Get this from the Fanvue Developer Area once you have configured a redirect URI for your app
OAUTH_REDIRECT_URI="https://[your-app-name-here].dev:3001/api/oauth/callback"
# Add scopes here once you have configured them in your app, space separated, e.g. "read:self read:chat"
OAUTH_SCOPES=
OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
# Set this to whatever you want your session cookie to be called
SESSION_COOKIE_NAME=fvsession
# Set this to something secure, don't leak it
SESSION_SECRET=youshouldreallychangethis
# Don't change this, your app won't be able to talk to Fanvue's API if you do
API_BASE_URL=https://api.fanvue.com
BASE_URL=https://[your-app-name-here].dev:3001
# fal.ai API key, used for H3 Max video generation, identity-drift correction, last-frame
# extraction, and reference-photo storage. Get one from https://fal.ai/dashboard/keys
FAL_KEY=
# Groq API key, used for the in-call reply text/JSON generation (gpt-oss-120b).
# Get one from https://console.groq.com/keys
GROQ_API_KEY=

# Self-hosted swap service (services/swap); leave unset to have Swap mode report every clip as failed.
SWAP_SERVICE_URL=
# At least 32 characters: the CPU persona store verifies tickets with it and fails closed on a shorter one.
SWAP_TOKEN=
# The swap app's CPU PersonaStore web URL, for swap mode's persona list and registration.
SWAP_PERSONA_URL=
# Premium's Wan 14B service (services/wan14b); optional, defaults to the deployed ai-video-wan14b URL and reuses SWAP_TOKEN.
WAN14B_SERVICE_URL=
